SECRET_KEY=django-insecure-sariwaba-dev-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Leave DB_NAME blank to use local db.sqlite3 automatically.
# DB_NAME=sariwaba_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Google OAuth Client ID (Web Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Allowed CORS origins for Flutter web frontend
CORS_ALLOWED_ORIGINS=http://localhost:7357,http://127.0.0.1:7357
